# ═══════════════════════════════════════════════════════════════════
#  Mesa Careers AI — Environment Variables
#  Copy this file to .env and fill in your keys before running.
#  NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════════

# ── LLM ──────────────────────────────────────────────────────────────────────
# Get at: https://aistudio.google.com/app/apikey  |  Free tier: generous
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# ── Apify ─────────────────────────────────────────────────────────────────────
# Get at: https://apify.com  |  $5 free credits on signup
# Used for:
#   S1  → LinkedIn Profile Scraper  (URL input mode)
#   S3A → LinkedIn Jobs Scraper     (formal job listings)
#   S3A → Wellfound Scraper         (startup job listings)
#   S3B → LinkedIn Post Scraper     (founder hiring signals)
APIFY_API_KEY=apify_api_...

# ── Tavily ────────────────────────────────────────────────────────────────────
# Get at: https://tavily.com  |  Free: 1 000 credits/month
# Used for: S2 comp grounding, S3 company stage enrichment, S6 dossier research
TAVILY_API_KEY=tvly-...

# ── Email enrichment ──────────────────────────────────────────────────────────
# Apollo primary (~100 lookups/month free)  →  https://apollo.io
APOLLO_API_KEY=

# Hunter.io fallback (~50 credits/month free)  →  https://hunter.io
HUNTER_API_KEY=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get at: https://supabase.com  |  Free tier is sufficient for MVP
# Run db/schema.sql in the Supabase SQL editor before first use.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJ...

# ── Stage 4 quota (how many leads go to final Gemini scoring) ─────────────────
DIRECT_QUOTA=12       # Top N from formal listings (LinkedIn Jobs + Wellfound)
INDIRECT_QUOTA=8      # Top N from founder signals (LinkedIn Posts)
# DIRECT_QUOTA + INDIRECT_QUOTA = 20 leads sent to Phase 2 Gemini scoring

# ── Mesa benchmarks (change only if Mesa updates placement targets) ───────────
FRESHER_BENCHMARK_LPA=22       # <2 yrs exp → floor 22 LPA
NON_FRESHER_BENCHMARK_LPA=35   # ≥2 yrs exp → floor 35 LPA

# ── Pipeline tuning ───────────────────────────────────────────────────────────
MAX_RAW_LEADS=50          # Total raw leads collected before dedup + ranking
HIDDEN_SIGNAL_DAYS=14     # Days back to search for hiring posts (Tavily)
MIN_FIT_SCORE=55          # Leads below this final_score are not shown in UI
